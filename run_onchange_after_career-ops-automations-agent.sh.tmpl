{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail
# Script: {{ include "dot_local/bin/executable_career-ops-automations" | sha256sum }}
# Agent: {{ include "private_Library/LaunchAgents/net.gitman.career-ops-automations.plist.tmpl" | sha256sum }}
mkdir -p "$HOME/Library/Logs"
agent="$HOME/Library/LaunchAgents/net.gitman.career-ops-automations.plist"
service="gui/$(id -u)/net.gitman.career-ops-automations"
plutil -lint "$agent"
# Retire the agent's old label (net.gitman.career-ops-daily)
old_service="gui/$(id -u)/net.gitman.career-ops-daily"
if launchctl print "$old_service" >/dev/null 2>&1; then
    launchctl bootout "$old_service"
fi
rm -f "$HOME/Library/LaunchAgents/net.gitman.career-ops-daily.plist"
if launchctl print "$service" >/dev/null 2>&1; then
    launchctl bootout "$service"
    for ((attempt=0; attempt<40; attempt++)); do
        launchctl print "$service" >/dev/null 2>&1 || break
        sleep 0.25
    done
fi
launchctl enable "$service"
launchctl bootstrap "gui/$(id -u)" "$agent"
{{ end -}}
