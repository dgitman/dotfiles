#!/usr/bin/python3
"""Scan the git history of each repo given as an argument with TruffleHog.

Prints one line per finding: VERIFIED (a live credential), UNKNOWN (verification
hit an error), or FAILED (the repo could not be scanned), then a summary. It
never prints secret values, only the detector and where it was found. TruffleHog
tests each candidate credential against the service that issued it. Exits 1 if
any credential is live. Paths without a main checkout with commits are skipped.

To mark findings safe, add lines to ~/.config/repo-secret-scan/ignore. Each line
is a finding as printed, without its first word, or the start of one ending at a
space or colon: "owner/repo Detector" hides every such finding in that repo, and
"owner/repo Detector path/file" hides them in that file. Text after # is a
comment. Ignored findings are counted in the summary, never hidden silently.
"""
import json, os, subprocess, sys

TIMEOUT = 600
IGNORE = os.path.expanduser('~/.config/repo-secret-scan/ignore')


def load_ignores():
    try:
        with open(IGNORE) as f:
            return [e for e in (line.split('#', 1)[0].strip() for line in f) if e]
    except FileNotFoundError:
        return []


def ignored(description, ignores):
    return any(description == e or (description.startswith(e) and description[len(e)] in ' :')
               for e in ignores)


def scan(repo):
    """Return (results, error), where error is None if the scan finished."""
    command = ['trufflehog', 'git', 'file://' + repo, '--json', '--no-update',
               '--fail-on-scan-errors', '--results=verified,unknown']
    try:
        run = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL, text=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return [], f'timed out after {TIMEOUT}s'
    results = []
    for line in run.stdout.splitlines():
        try:
            results.append(json.loads(line))
        except ValueError:
            pass
    return results, None if run.returncode == 0 else f'exit {run.returncode}'


def describe(name, result):
    git = result.get('SourceMetadata', {}).get('Data', {}).get('Git', {})
    return (f"{name} {result.get('DetectorName', 'unknown detector')} "
            f"{git.get('file', '?')}:{git.get('line', '?')} commit {str(git.get('commit', '?'))[:7]}")


def main(paths):
    # No index means no commits yet (TruffleHog errors on those). A worktree's .git
    # is a file, and its history is scanned with the main checkout.
    repos = [os.path.abspath(p) for p in paths if os.path.isfile(os.path.join(p, '.git', 'index'))]
    ignores = load_ignores()
    live = skipped = 0
    for repo in repos:
        # Owner/name, so the home path stays out of the output.
        name = '/'.join(repo.split('/')[-2:])
        results, error = scan(repo)
        for line in sorted({('VERIFIED' if r.get('Verified') else 'UNKNOWN', describe(name, r)) for r in results}):
            if ignored(line[1], ignores):
                skipped += 1
                continue
            print(*line)
            live += line[0] == 'VERIFIED'
        if error:
            print('FAILED', name, error)
    print(f'scanned {len(repos)} repos' + (f', {skipped} findings ignored' if skipped else ''))
    return 1 if live else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
