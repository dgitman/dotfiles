# ==============================================================================
# SYSTEM & ENVIRONMENT VARIABLES
# ==============================================================================
export HOMEBREW_AUTO_UPDATE_SECS=86400  # Only auto-update Homebrew once per day
export HOMEBREW_GITHUB_API_TOKEN='{{ onepasswordRead "op://Private/ilisfoloivekdguzpnjepypsbi/token" | replace "'" "'\"'\"'" }}'

# Unique arrays prevent duplicate shell path entries
typeset -U path fpath

# ==============================================================================
# CORE INTEGRATIONS
# ==============================================================================

# Homebrew Core Initialization (Sets up PATH and paths automatically)
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# homebrew Shell Completions
autoload -Uz compinit
compinit

# 1Password CLI plugin
[[ -r "$HOME/.config/op/plugins.sh" ]] && source "$HOME/.config/op/plugins.sh"

# Docker Desktop CLI completions
if [ -d "$HOME/.docker/completions" ]; then
    fpath=("$HOME/.docker/completions" $fpath)
fi

# ==============================================================================
# ALIASES & SHELL PREFERENCES
# ==============================================================================
alias d="cd ~/Developer"
alias dotfiles="cd ~/.local/share/chezmoi"
alias brew-bump-casks="brew list --cask | xargs -I {} brew bump --open-pr --cask {}"

# History Optimization
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt SHARE_HISTORY          # Share history across all open terminal windows
setopt HIST_IGNORE_ALL_DUPS   # Don't record duplicate commands
setopt HIST_REDUCE_BLANKS     # Remove extra spaces from history items
setopt AUTO_CD                # Type a directory path without 'cd' to jump into it

# ==============================================================================
# CUSTOM FUNCTIONS
# ==============================================================================

# Strip all active APIs from a given GCP project ID
gcp-strip-apis() {
    if [ -z "$1" ]; then
        echo "❌ Error: Please provide a project ID. Example: gcp-strip-apis my-project-id"
        return 1
    fi
    echo "⚠️ Stripping all enabled APIs from project: $1..."
    gcloud services disable $(gcloud services list --enabled --project="$1" --format="value(config.name)") --project="$1" --force
}