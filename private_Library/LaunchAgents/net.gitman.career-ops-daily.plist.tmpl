<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.gitman.career-ops-daily</string>
  <key>ProgramArguments</key><array><string>{{ .chezmoi.homeDir | html }}/.local/bin/career-ops-automations</string></array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>3</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>3</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>3</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>3</integer></dict>
  </array>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{{ .chezmoi.homeDir | html }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/career-ops-daily.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/career-ops-daily.log</string>
</dict></plist>
