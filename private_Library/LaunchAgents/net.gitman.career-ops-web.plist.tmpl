<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.gitman.career-ops-web</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>
# Single-flight guard: two overlapping installs corrupt node_modules (ENOTEMPTY).
# mkdir is atomic; the owner pid lets a later run steal a lock left by a dead process.
guard=/tmp/career-ops-web-install.lock
child=
cleanup() { [ -n "$child" ] &amp;&amp; kill "$child" 2>/dev/null; rm -rf "$guard"; }
for i in $(seq 1 200); do
  if mkdir "$guard" 2>/dev/null; then echo $$ > "$guard/pid"; break; fi
  owner=$(cat "$guard/pid" 2>/dev/null)
  if [ -n "$owner" ] &amp;&amp; ! kill -0 "$owner" 2>/dev/null; then rm -rf "$guard"; continue; fi
  echo "another install/build holds $guard (pid $owner); waiting"
  sleep 3
done
[ "$(cat "$guard/pid" 2>/dev/null)" = "$$" ] || { echo "could not take $guard"; exit 1; }
trap 'cleanup; exit 143' TERM INT
trap cleanup EXIT
# Run a command in the background and wait, so a TERM can interrupt it and kill the child.
run() { "$@" &amp; child=$!; wait $child; rc=$?; child=; return $rc; }
# Install only when package-lock.json changed since the last npm ci.
lock=$(shasum package-lock.json | cut -d' ' -f1)
if [ "$(cat node_modules/.ci-stamp 2>/dev/null)" != "$lock" ]; then
  rm -f .next/.build-stamp
  # npm ci can fail with ENOTEMPTY when something (Spotlight, another install) touches
  # node_modules mid-delete. Wipe it and retry before giving up.
  ok=0
  for attempt in 1 2 3; do
    if run npm ci; then ok=1; break; fi
    echo "npm ci failed (attempt $attempt); wiping node_modules and retrying"
    rm -rf node_modules
    sleep 5
  done
  [ "$ok" = 1 ] || exit 1
  echo "$lock" > node_modules/.ci-stamp
fi
# Build only when the repo commit or its uncommitted changes differ from the last build.
src=$( { git rev-parse HEAD; git status --porcelain; git diff HEAD; } | shasum | cut -d' ' -f1)
if [ "$(cat .next/.build-stamp 2>/dev/null)" != "$src" ]; then
  # A failed build usually means a corrupt install; drop the stamp so the next launch reinstalls.
  run npm run build || { rm -f node_modules/.ci-stamp; exit 1; }
  echo "$src" > .next/.build-stamp
fi
trap - EXIT TERM INT
rm -rf "$guard"
exec npm start
</string>
  </array>
  <key>WorkingDirectory</key><string>{{ .chezmoi.homeDir }}/Developer/public/career-ops/web</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/career-ops-web.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/career-ops-web.log</string>
</dict></plist>
