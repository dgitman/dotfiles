{
  "mcpServers": {
    "1password": {
      "command": "1password-mcp",
      "args": []
    },
    "Apify": {
      "url": "https://mcp.apify.com"
    },
    "Bright Data": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "sh",
        "-c",
        "exec npx -y mcp-remote \"https://mcp.brightdata.com/mcp?token=$BRIGHT_DATA_API_KEY\""
      ],
      "env": {
        "BRIGHT_DATA_API_KEY": "op://Employee/527zuc4qn45pthp2vmha37bw2m/API Key"
      }
    },
    "Canva": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.canva.com/mcp"
      ]
    },
    "Cloudflare Bindings": {
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "Cloudflare Builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp"
    },
    "Cloudflare Docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "Cloudflare Observability": {
      "url": "https://observability.mcp.cloudflare.com/mcp"
    },
    "Composio": {
      "url": "https://connect.composio.dev/mcp"
    },
    "Decile Hub": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "sh",
        "-c",
        "exec npx -y mcp-remote https://decilehub.com/mcp --header \"X-Decile-API-Key:$DECILE_HUB_API_KEY\""
      ],
      "env": {
        "DECILE_HUB_API_KEY": "op://Employee/nqqsk2hwmnjvdruchd3yhiqcde/API Key"
      }
    },
    "Figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "GitHub": {
      "command": "{{ .chezmoi.homeDir }}/.warp/bin/github-mcp.sh",
      "args": []
    },
    "Make": {
      "url": "https://mcp.make.com"
    },
    "Notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "Postman": {
      "url": "https://mcp.postman.com/mcp"
    },
    "Shopify Dev": {
      "command": "npx",
      "args": [
        "-y",
        "@shopify/dev-mcp@latest"
      ]
    },
    "Slack": {
      "command": "{{ .chezmoi.homeDir }}/.warp/bin/slack-mcp.sh",
      "args": []
    },
    "Stripe": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.stripe.com",
        "--static-oauth-client-metadata",
        "{\"scope\": \"mcp\"}"
      ]
    },
    "Supabase": {
      "url": "https://mcp.supabase.com/mcp"
    },
    "trakt": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "uvx",
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/wwiens/trakt_mcpserver",
        "trakt-mcp"
      ],
      "env": {
        "TRAKT_CLIENT_ID": "op://Private/t7aiboqrptwqpqk6fe5em4ag7u/client_id",
        "TRAKT_CLIENT_SECRET": "op://Private/t7aiboqrptwqpqk6fe5em4ag7u/client_secret"
      }
    },
    "Upwork": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.upwork.com/mcp"
      ]
    },
    "Webflow": {
      "url": "https://mcp.webflow.com/mcp"
    },
    "Workspace MCP - Business": {
      "url": "https://private.workspacemcp.com/mcp?david@because.ventures"
    },
    "Workspace MCP - Personal": {
      "url": "https://private.workspacemcp.com/mcp?davidmarkgitman@gmail.com"
    },
    "X": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "npx",
        "-y",
        "@xdevplatform/xurl",
        "mcp",
        "https://api.x.com/mcp"
      ],
      "env": {
        "CLIENT_ID": "op://Private/mnubbxp5r4vbrlbyow6nfem5wi/client_id",
        "CLIENT_SECRET": "op://Private/mnubbxp5r4vbrlbyow6nfem5wi/client_secret"
      }
    },
    "Zapier": {
