{{- $computerName := output "scutil" "--get" "ComputerName" | trim -}}
{{- $personalEmail := onepasswordRead "op://ts4jmaranagdjfxrtkfukeglcm/nijakk5lonp577fq6ha5avc3v4/username" -}}
{{- $workEmail := onepasswordRead "op://ts4jmaranagdjfxrtkfukeglcm/qpwizlxov5vwmrbeytqvha7xu4/username" -}}
{{- /* Extra values git-hooks/pre-commit keeps out of this public repo. */ -}}
{{- $privateValues := list
      (onepasswordRead "op://ts4jmaranagdjfxrtkfukeglcm/wdb54vvhengg7go5dfno6kxk5y/username")
      (onepasswordRead "op://ts4jmaranagdjfxrtkfukeglcm/wdb54vvhengg7go5dfno6kxk5y/email") -}}

[onepassword]
mode = "account"

[data]
computerName = "{{ $computerName }}"
personalEmail = {{ $personalEmail | quote }}
workEmail = {{ $workEmail | quote }}
privateValues = [{{ range $i, $v := $privateValues }}{{ if $i }}, {{ end }}{{ $v | quote }}{{ end }}]

[git]
autoCommit = false
autoPush = false

[edit]
    command = "code"
    args = ["--wait"]

[diff]
    command = "code"
    args = ["--wait", "--diff"]

{{/* Raw string: .Target/.Destination/.Source are filled in by chezmoi merge, not at init. */ -}}
{{`[merge]
    command = "bash"
    args = [
        "-c",
        "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}",
    ]`}}
