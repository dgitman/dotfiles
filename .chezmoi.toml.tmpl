{{- $computerName := output "scutil" "--get" "ComputerName" | trim -}}
{{- $personalEmail := promptStringOnce . "personalEmail" "Personal email (Workspace MCP)" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Work email (Workspace MCP)" -}}

[onepassword]
mode = "account"

[data]
computerName = "{{ $computerName }}"
personalEmail = "{{ $personalEmail }}"
workEmail = "{{ $workEmail }}"

[git]
autoCommit = false
autoPush = false

[edit]
    command = "code"
    args = ["--wait"]

[diff]
    command = "code"
    args = ["--wait", "--diff"]

{{/* Raw string: .Target/.Destination/.Source are filled in by chezmoi merge, not at init. */ -}}
{{`[merge]
    command = "bash"
    args = [
        "-c",
        "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}",
    ]`}}
