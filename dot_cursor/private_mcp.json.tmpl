{
  "mcpServers": {
    "Bright Data": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "sh",
        "-c",
        "exec npx mcp-remote \"https://mcp.brightdata.com/mcp?token=${BRIGHT_DATA_API_KEY}\""
      ],
      "env": {
        "BRIGHT_DATA_API_KEY": "op://Employee/527zuc4qn45pthp2vmha37bw2m/API Key"
      }
    },
    "decilehub": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "npx",
        "-y",
        "mcp-remote",
        "https://decilehub.com/mcp",
        "--header",
        "X-Decile-API-Key:${DECILE_HUB_API_KEY}"
      ],
      "env": {
        "DECILE_HUB_API_KEY": "op://Employee/nqqsk2hwmnjvdruchd3yhiqcde/API Key"
      }
    },
    "Make": {
      "url": "https://mcp.make.com"
    },
    "Notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "Postman": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.postman.com/mcp",
        "--header",
        "Authorization: Bearer ${POSTMAN_API_KEY}"
      ],
      "env": {
        "POSTMAN_API_KEY": "op://Employee/52ueu3iii4m6jo3pnrqpl6npbm/API Key"
      }
    },
    "trakt": {
      "command": "/opt/homebrew/bin/op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "uvx",
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/wwiens/trakt_mcpserver",
        "trakt-mcp"
      ],
      "env": {
        "TRAKT_CLIENT_ID": "op://Private/t7aiboqrptwqpqk6fe5em4ag7u/client_id",
        "TRAKT_CLIENT_SECRET": "op://Private/t7aiboqrptwqpqk6fe5em4ag7u/client_secret"
      }
    },
    "Upwork": {
      "url": "https://mcp.upwork.com/mcp"
    },
    "Workspace MCP - Business": {
      "url": "https://private.workspacemcp.com/mcp?{{ .workEmail }}",
      "headers": {}
    },
    "Workspace MCP - Personal": {
      "url": "https://private.workspacemcp.com/mcp?{{ .personalEmail }}",
      "headers": {}
    }
  }
}
