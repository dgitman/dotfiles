{
  "mcpServers": {
    "trakt": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/wwiens/trakt_mcpserver",
        "trakt-mcp"
      ],
      "env": {
        "TRAKT_CLIENT_ID": {{ onepasswordRead "op://ts4jmaranagdjfxrtkfukeglcm/t7aiboqrptwqpqk6fe5em4ag7u/client_id" | toJson }},
        "TRAKT_CLIENT_SECRET": {{ onepasswordRead "op://ts4jmaranagdjfxrtkfukeglcm/t7aiboqrptwqpqk6fe5em4ag7u/client_secret" | toJson }}
      }
    },
    "n8n": {
      "url": "https://dgitman.app.n8n.cloud/mcp-server/http",
      "headers": {}
    },
    "linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest",
        "--transport",
        "stdio"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}