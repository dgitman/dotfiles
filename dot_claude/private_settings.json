{
  "enabledPlugins": {
    "imessage@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "make-marketplace": {
      "source": {
        "source": "github",
        "repo": "integromat/make-skills"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "enableWorkflows": true,
  "model": "claude-3-7-sonnet",
  "effortLevel": "high",
  "permissions": {
    "deny": [
      "Read(~/.env*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(pip install *)"
    ],
    "allow": [
      "Bash(.venv/bin/python:*)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(pytest *)",
      "Bash(npm test)",
      "Read(package.json)",
      "Read(requirements.txt)",
      "Read(pyproject.toml)"
    ]
  }
}

