{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail
# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

# Before scripts run before ~/.Brewfile is updated, so install from source state.
brewfile=$(mktemp "${TMPDIR:-/tmp}/chezmoi-Brewfile.XXXXXX")
trap 'rm -f "$brewfile"' EXIT

# Skip taps that cannot work on another Mac: homebrew/core (Homebrew refuses
# to tap it) and local taps whose directory does not exist yet. brewfile-sync
# keeps writing them back, so they are filtered here instead of in the Brewfile.
local_tap='^tap "[^"]+", File\.join\(Dir\.home, "([^"]+)"\)'
while IFS= read -r line; do
  if [[ "$line" == 'tap "homebrew/core"'* ]]; then
    continue
  fi
  if [[ "$line" =~ $local_tap ]] && [ ! -d "$HOME/${BASH_REMATCH[1]}" ]; then
    echo "Skipping local tap until $HOME/${BASH_REMATCH[1]} exists: $line" >&2
    continue
  fi
  printf '%s\n' "$line"
done > "$brewfile" <<'CHEZMOI_BREWFILE'
{{ include "dot_Brewfile" }}
CHEZMOI_BREWFILE

echo "Syncing Homebrew packages from tracked Brewfile..."
brew bundle --file="$brewfile"
{{ end -}}
