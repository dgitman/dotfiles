#!/bin/bash
# Global pre-commit hook (hook.global-pre-commit in ~/.gitconfig): run the global
# pre-commit config (gitleaks secret scan), then the repository's own
# .pre-commit-config.yaml unless `pre-commit install` already hooked it up. Git
# runs the repository's own hooks itself, after this one.
set -euo pipefail

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "Global pre-commit hook: pre-commit is not installed; secret scan skipped." >&2
  exit 0
fi

config="$HOME/.config/pre-commit/config.yaml"
if [ -f "$config" ]; then
  pre-commit run --config "$config" --hook-stage pre-commit
fi
repo_config="$(git rev-parse --show-toplevel)/.pre-commit-config.yaml"
repo_hook="$(git rev-parse --git-path hooks)/pre-commit"
if [ -f "$repo_config" ] && [ ! -x "$repo_hook" ]; then
  pre-commit run --config "$repo_config" --hook-stage pre-commit
fi
