{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail
# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

# Before scripts run before ~/.Brewfile is updated, so install from source state.
brewfile=$(mktemp "${TMPDIR:-/tmp}/chezmoi-Brewfile.XXXXXX")
trap 'rm -f "$brewfile"' EXIT

# Skip taps that do not restore: homebrew/core (Homebrew refuses to tap it) and
# taps of local development checkouts (dgitman/cask-local is a homebrew-cask
# fork that Homebrew rejects as a third-party tap). brewfile-sync keeps writing
# them back, so they are filtered here instead of in the Brewfile.
local_tap='^tap "[^"]+", File\.join\(Dir\.home, "[^"]+"\)'
while IFS= read -r line; do
  if [[ "$line" == 'tap "homebrew/core"'* ]]; then
    continue
  fi
  if [[ "$line" =~ $local_tap ]]; then
    echo "Skipping local development tap: $line" >&2
    continue
  fi
  printf '%s\n' "$line"
done > "$brewfile" <<'CHEZMOI_BREWFILE'
{{ include "dot_Brewfile" }}
CHEZMOI_BREWFILE

echo "Syncing Homebrew packages from tracked Brewfile..."
brew bundle --file="$brewfile"

# Some cask installers run with sudo and create ~/Library/LaunchAgents as root,
# which makes chezmoi fail when it writes the tracked LaunchAgents next.
launch_agents="$HOME/Library/LaunchAgents"
if [ -d "$launch_agents" ] && [ ! -O "$launch_agents" ]; then
  echo "Fixing ownership of $launch_agents (created as another user by an installer)..."
  sudo chown "$(id -un):staff" "$launch_agents"
fi
{{ end -}}
